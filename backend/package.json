{
  "name": "entregaprova-backend",
  "version": "0.1.0",
  "description": "Backend API para o projeto EntregaProva",
  "main": "dist/server.js",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-entregaprova \"vitest run tests/security/firestore-rules.test.ts\"",
    "test:emulator": "tsc -p tsconfig.test.json && npx --yes firebase-tools@latest emulators:exec --only firestore --project demo-entregaprova --config ../firebase.json \"vitest run\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^12.6.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.0",
    "firebase": "^13.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.16.2",
    "typescript": "~5.5.4",
    "vitest": "^1.6.0"
  }
}
