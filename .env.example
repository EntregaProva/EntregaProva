# Copie para .env (cp .env.example .env). O .env real NUNCA vai para o GitHub.
# Nenhum valor abaixo e segredo: sao valores falsos para uso com emuladores.

#  Geral 
NODE_ENV=development
GCP_PROJECT_ID=demo-entregaprova   # prefixo "demo-" = emuladores nao tocam na nuvem

# Backend
PORT=3000
STORAGE_BUCKET=demo-entregaprova.appspot.com
# O compose ja injeta estes tres apontando para o servico "emulators".
# Preencha so se rodar a API fora do Docker.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Frontend (Vite) 
VITE_API_URL=http://localhost:3000
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-entregaprova.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-entregaprova
VITE_FIREBASE_STORAGE_BUCKET=demo-entregaprova.appspot.com
VITE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_STORAGE_EMULATOR_HOST=localhost
VITE_STORAGE_EMULATOR_PORT=9199
