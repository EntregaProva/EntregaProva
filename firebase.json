{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0",
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "entregaprova-app/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "entregaprova-api", "region": "us-central1", "pinTag": true }
      },
      {
        "source": "/healthz",
        "run": { "serviceId": "entregaprova-api", "region": "us-central1", "pinTag": true }
      },
      {
        "source": "/readyz",
        "run": { "serviceId": "entregaprova-api", "region": "us-central1", "pinTag": true }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
